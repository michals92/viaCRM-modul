# EspoCRM Deploy Configuration Template
# Copy this file to .env and fill in your values

# EspoCRM Installation Path (local deployment)
ESPO_PATH=/path/to/your/espocrm

# OR use HTTP deployment
ESPO_URL=http://localhost:8080
ESPO_USERNAME=admin
ESPO_PASSWORD=your_password

# Docker deployment (if using Docker)
DOCKER_CONTAINER=espocrm-app

# Deploy Method (choose one):
# - 'local' = copy files directly to EspoCRM directory
# - 'http' = upload via HTTP API (requires extension manager)
# - 'docker' = copy to Docker container
DEPLOY_METHOD=docker