{
    "table": "offer",
    "languageCategory": "Offer",
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "offerNumber": {
            "type": "varchar",
            "trim": true,
            "unique": false
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Sent",
                "Accepted",
                "Rejected",
                "Expired"
            ],
            "default": "Draft"
        },
        "account": {
            "type": "link",
            "required": false
        },
        "contact": {
            "type": "link"
        },
        "validUntil": {
            "type": "date",
            "required": false
        },
        "dateOffered": {
            "type": "date"
        },
        "amount": {
            "type": "currency"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt",
                "deleted"
            ]
        }
    }
}