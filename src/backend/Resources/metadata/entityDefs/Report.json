{
    "table": "report",
    "languageCategory": "Report",
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive"
            ],
            "default": "Active"
        },
        "description": {
            "type": "text"
        },
        "type": {
            "type": "enum",
            "options": [
                "List",
                "Grid",
                "Chart"
            ],
            "default": "List",
            "required": true
        },
        "targetEntity": {
            "type": "varchar",
            "required": true,
            "default": "",
            "tooltip": "Entity to generate report from",
            "view": "viacrm:views/fields/target-entity-select"
        },
        "columns": {
            "type": "jsonArray",
            "required": false,
            "tooltip": "Fields to display in the report",
            "view": "viacrm:views/fields/entity-columns"
        },
        "groupBy": {
            "type": "varchar",
            "required": false,
            "tooltip": "Field to group data by",
            "view": "viacrm:views/fields/entity-field-select"
        },
        "orderBy": {
            "type": "varchar",
            "required": false,
            "tooltip": "Field to order data by",
            "view": "viacrm:views/fields/entity-field-select"
        },
        "orderDirection": {
            "type": "enum",
            "options": ["ASC", "DESC"],
            "default": "ASC"
        },
        "chartType": {
            "type": "enum",
            "options": [
                "Bar",
                "Line",
                "Pie",
                "Doughnut"
            ],
            "default": "Bar"
        },
        "exportFormats": {
            "type": "jsonArray",
            "default": ["CSV", "Excel", "PDF"],
            "tooltip": "Available export formats for this report",
            "view": "viacrm:views/fields/export-formats"
        },
        "refreshInterval": {
            "type": "int",
            "min": 0,
            "tooltip": "Auto-refresh interval in minutes (0 = manual only)"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt",
                "deleted"
            ]
        }
    }
}