{
	"fields": {
		"assignedUser": {
			"type": "link",
			"required": false,
			"view": "views/fields/assigned-user"
		},
		"createdAt": {
			"type": "datetime",
			"readOnly": true
		},
		"createdBy": {
			"type": "link",
			"view": "views/fields/user",
			"readOnly": true
		},
		"description": {
			"type": "text"
		},
		"modifiedAt": {
			"type": "datetime",
			"readOnly": true
		},
		"modifiedBy": {
			"type": "link",
			"view": "views/fields/user",
			"readOnly": true
		},
		"name": {
			"type": "varchar",
			"required": true,
			"pattern": "$noBadCharacters"
		},
		"rate": {
			"type": "currency"
		},
		"teams": {
			"type": "linkMultiple",
			"view": "views/fields/teams"
		}
	},
	"links": {
