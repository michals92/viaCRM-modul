			"noLoad": false,
			"importDisabled": false,
			"exportDisabled": false,
			"recordListEnabled": true,
			"recordListLinkDisabled": false,
			"recordListConfirmRemove": true,
			"recordListLayout": "listSmall"
		},
		"supplierProductCode": {
			"type": "varchar",
