	"links": {
		"accountEmailAddresses": {
			"type": "hasMany",
			"entity": "EmailAddress",
			"foreign": "account"
		},
		"accountPhoneNumbers": {
			"type": "hasMany",
			"entity": "PhoneNumber",
			"foreign": "account"
		},
		"primarySupplierOf": {
			"type": "hasMany",
			"entity": "Product",
			"foreign": "primarySupplier"
		},
		"productSupplierItems": {
			"type": "hasMany",
			"entity": "ProductSupplierItem",
			"foreign": "account",
			"audited": false
		},
		"productSerials": {
			"type": "hasMany",
			"entity": "ProductSerial",
			"foreign": "currentOwner"
		},
		"products": {
			"type": "hasMany",
			"entity": "Product",
			"relationName": "productAccount",
			"foreign": "suppliers"
		}
