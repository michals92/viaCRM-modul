				"Customer": "success",
				"Supplier": "info"
			},
			"displayAsLabel": true
		},
		"vatId": {
			"type": "varchar",
			"maxLength": 40,
			"trim": true,
			"pattern": "$noBadCharacters",
			"noSpellCheck": true
		},
