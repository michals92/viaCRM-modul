{
	"fields": {
		"color": {
			"type": "colorpicker",
			"tooltip": true
		},
		"iconClass": {
			"type": "varchar",
			"view": "viacrm:views/fields/icon-class",
			"maxLength": 50
		},
		"name": {
			"view": "viacrm:views/team/fields/name"
		},
		"users": {
			"type": "linkMultiple",
			"columns": {
				"role": "teamRole"
			},
			"additionalAttributeList": ["columns"],
			"recordListCreateDisabled": true,
			"recordListEnabled": true,
			"recordListLayout": "listForTeam"
		}
	}
}
