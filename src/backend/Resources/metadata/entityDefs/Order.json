{
    "table": "order",
    "languageCategory": "Order",
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "orderNumber": {
            "type": "varchar",
            "trim": true,
            "unique": false
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Confirmed",
                "Processing",
                "Shipped",
                "Delivered",
                "Cancelled",
                "Refunded"
            ],
            "default": "Draft"
        },
        "account": {
            "type": "link",
            "required": false
        },
        "contact": {
            "type": "link"
        },
        "offer": {
            "type": "link"
        },
        "orderDate": {
            "type": "date"
        },
        "expectedDeliveryDate": {
            "type": "date"
        },
        "actualDeliveryDate": {
            "type": "date"
        },
        "shippingAddress": {
            "type": "text"
        },
        "billingAddress": {
            "type": "text"
        },
        "shippingMethod": {
            "type": "varchar"
        },
        "paymentMethod": {
            "type": "varchar"
        },
        "paymentTerms": {
            "type": "varchar"
        },
        "vendorInvoiceNumber": {
            "type": "varchar"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "orderItems": {
            "type": "orderItems"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact"
        },
        "offer": {
            "type": "belongsTo",
            "entity": "Offer"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "orderNumber": {
            "columns": [
                "orderNumber",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt",
                "deleted"
            ]
        },
        "account": {
            "columns": [
                "accountId",
                "deleted"
            ]
        }
    }
}