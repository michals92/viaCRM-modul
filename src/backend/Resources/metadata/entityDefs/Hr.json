{
	"table": "hr",
	"languageCategory": "Hr",
	"fields": {
		"name": {
			"type": "varchar",
			"required": true,
			"maxLength": 255
		},
		"firstName": {
			"type": "varchar",
			"maxLength": 100,
			"tooltip": false
		},
		"lastName": {
			"type": "varchar",
			"maxLength": 100,
			"tooltip": false
		},
		"email": {
			"type": "email"
		},
		"phone": {
			"type": "phone"
		},
		"position": {
			"type": "varchar",
			"maxLength": 150
		},
		"department": {
			"type": "enum",
			"options": ["HR", "IT", "Finance", "Sales", "Marketing", "Operations", "Management"]
		},
		"employeeId": {
			"type": "varchar",
			"maxLength": 50
		},
		"hireDate": {
			"type": "date"
		},
		"salary": {
			"type": "currency"
		},
		"status": {
			"type": "enum",
			"options": ["Active", "Inactive", "Terminated", "On Leave"],
			"default": "Active"
		},
		"manager": {
			"type": "link"
		},
		"notes": {
			"type": "text"
		},
		"assignedUser": {
			"type": "link"
		},
		"createdAt": {
			"type": "datetime",
			"readOnly": true
		},
		"modifiedAt": {
			"type": "datetime",
			"readOnly": true
		},
		"createdBy": {
			"type": "link",
			"readOnly": true
		},
		"modifiedBy": {
			"type": "link",
			"readOnly": true
		},
		"absences": {
			"type": "linkMultiple",
			"entity": "Absence"
		},
		"workingHours": {
			"type": "float",
			"min": 0,
			"max": 40,
			"default": 40,
			"tooltip": "Weekly working hours"
		},
		"workingHoursType": {
			"type": "enum",
			"options": ["Full-time", "Part-time"],
			"default": "Full-time"
		},
		"workingSchedule": {
			"type": "text",
			"maxLength": 500,
			"tooltip": "Detailed working schedule (days, hours)"
		},
		"fte": {
			"type": "float",
			"min": 0,
			"max": 1,
			"decimalPlaces": 2,
			"tooltip": "Full Time Equivalent (0.5 = 50%, 1.0 = 100%)"
		},
		"workingDays": {
			"type": "multiEnum",
			"options": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"default": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
		},
		"partTimeStartDate": {
			"type": "date",
			"tooltip": "Start date of part-time arrangement"
		},
		"partTimeEndDate": {
			"type": "date",
			"tooltip": "End date of part-time arrangement (if temporary)"
		},
		"vacationHoursTotal": {
			"type": "float",
			"min": 0,
			"default": 160,
			"tooltip": "Celkový počet hodin dovolené na rok"
		},
		"vacationHoursUsed": {
			"type": "float",
			"min": 0,
			"default": 0,
			"tooltip": "Počet vyčerpaných hodin dovolené"
		},
		"vacationHoursRemaining": {
			"type": "float",
			"min": 0,
			"readOnly": true,
			"tooltip": "Zbývající hodiny dovolené"
		},
		"sickLeaveHours": {
			"type": "float",
			"min": 0,
			"default": 0,
			"tooltip": "Počet hodin nemocenské"
		},
		"documents": {
			"type": "attachmentMultiple",
			"maxFileSize": 20,
			"accept": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".png", ".jpg", ".jpeg"],
			"tooltip": "Employee documents and files"
		}
	},
	"links": {
		"manager": {
			"type": "belongsTo",
			"entity": "User"
		},
		"assignedUser": {
			"type": "belongsTo",
			"entity": "User"
		},
		"createdBy": {
			"type": "belongsTo",
			"entity": "User"
		},
		"modifiedBy": {
			"type": "belongsTo",
			"entity": "User"
		},
		"absences": {
			"type": "hasMany",
			"entity": "Absence",
			"foreign": "hrRecord"
		}
	},
	"dynamicLogic": {
		"fields": {
			"partTimeStartDate": {
				"visible": {
					"conditionGroup": [
						{
							"type": "equals",
							"attribute": "workingHoursType",
							"value": "Part-time"
						}
					]
				}
			},
			"partTimeEndDate": {
				"visible": {
					"conditionGroup": [
						{
							"type": "equals",
							"attribute": "workingHoursType",
							"value": "Part-time"
						}
					]
				}
			},
			"workingHours": {
				"required": {
					"conditionGroup": [
						{
							"type": "equals",
							"attribute": "workingHoursType",
							"value": "Part-time"
						}
					]
				}
			}
		},
		"options": {
			"workingHours": {
				"conditionGroup": [
					{
						"type": "equals",
						"attribute": "workingHoursType",
						"value": "Full-time"
					}
				],
				"actions": [
					{
						"type": "setValue",
						"attribute": "workingHours",
						"value": 40
					}
				]
			}
		}
	},
	"collection": {
		"orderBy": "name",
		"order": "asc"
	},
	"indexes": {
		"name": {
			"columns": ["name", "deleted"]
		},
		"employeeId": {
			"columns": ["employeeId", "deleted"]
		},
		"department": {
			"columns": ["department", "deleted"]
		}
	}
}
