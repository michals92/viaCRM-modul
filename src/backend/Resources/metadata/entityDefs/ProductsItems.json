{
    "table": "products_items",
    "languageCategory": "ProductsItems",
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true,
            "maxLength": 255
        },
        "sku": {
            "type": "varchar",
            "required": true,
            "trim": true,
            "maxLength": 100
        },
        "barcode": {
            "type": "varchar",
            "trim": true,
            "maxLength": 50
        },
        "productType": {
            "type": "enum",
            "options": [
                "physical",
                "virtual",
                "service"
            ],
            "default": "physical",
            "required": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive",
                "Discontinued"
            ],
            "default": "Active"
        },
        "category": {
            "type": "varchar",
            "maxLength": 150
        },
        "brand": {
            "type": "varchar",
            "maxLength": 100
        },
        "price": {
            "type": "currency",
            "required": false
        },
        "costPrice": {
            "type": "currency",
            "required": false
        },
        "weight": {
            "type": "float",
            "min": 0
        },
        "dimensions": {
            "type": "varchar",
            "maxLength": 100
        },
        "stockQuantity": {
            "type": "int",
            "default": 0,
            "min": 0
        },
        "minStockLevel": {
            "type": "int",
            "default": 0,
            "min": 0
        },
        "maxStockLevel": {
            "type": "int",
            "min": 0
        },
        "unit": {
            "type": "enum",
            "options": [
                "pcs",
                "kg",
                "liter",
                "meter",
                "hours",
                "license"
            ],
            "default": "pcs"
        },
        "taxRate": {
            "type": "float",
            "min": 0,
            "max": 100
        },
        "isActive": {
            "type": "bool",
            "default": true
        },
        "notes": {
            "type": "text"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "offers": {
            "type": "linkMultiple",
            "view": "views/fields/link-multiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "offers": {
            "type": "hasMany",
            "entity": "Offer",
            "foreign": "productsItems",
            "relationName": "offerProductsItems"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt",
                "deleted"
            ]
        }
    }
}