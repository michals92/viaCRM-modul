{
    "table": "invoice",
    "languageCategory": "Invoice",
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "invoiceNumber": {
            "type": "number",
            "unique": true,
            "readOnly": true
        },
        "variableSymbol": {
            "type": "varchar",
            "maxLength": 10,
            "trim": true,
            "pattern": "^[0-9]{0,10}$"
        },
        "constantSymbol": {
            "type": "varchar",
            "maxLength": 10,
            "trim": true,
            "pattern": "^[0-9]{0,10}$"
        },
        "specificSymbol": {
            "type": "varchar",
            "maxLength": 10,
            "trim": true,
            "pattern": "^[0-9]{0,10}$"
        },
        "invoiceType": {
            "type": "enum",
            "options": [
                "standard",
                "advance",
                "proforma",
                "creditNote",
                "taxDocument"
            ],
            "default": "standard"
        },
        "account": {
            "type": "link",
            "required": true
        },
        "accountName": {
            "type": "varchar",
            "disabled": true
        },
        "accountVatId": {
            "type": "varchar",
            "maxLength": 50,
            "trim": true
        },
        "billingAddress": {
            "type": "address"
        },
        "shippingAddress": {
            "type": "address"
        },
        "contactPerson": {
            "type": "link"
        },
        "invoiceEmail": {
            "type": "email"
        },
        "issueDate": {
            "type": "date",
            "required": true
        },
        "taxableSupplyDate": {
            "type": "date",
            "required": true
        },
        "dueDate": {
            "type": "date",
            "required": true
        },
        "paymentDays": {
            "type": "int",
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": [
                "draft",
                "sent",
                "paid",
                "cancelled"
            ],
            "default": "draft",
            "style": {
                "draft": "default",
                "sent": "primary",
                "paid": "success",
                "cancelled": "danger"
            }
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "attachments": {
            "type": "attachmentMultiple"
        }
    },
    "links": {
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "invoices"
        },
        "contactPerson": {
            "type": "belongsTo",
            "entity": "Contact"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "attachments": {
            "type": "hasChildren",
            "entity": "Attachment",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true,
            "relationName": "attachments"
        }
    },
    "collection": {
        "orderBy": "invoiceNumber",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "invoiceNumber": {
            "columns": [
                "invoiceNumber",
                "deleted"
            ],
            "unique": true
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "issueDate": {
            "columns": [
                "issueDate",
                "deleted"
            ]
        },
        "dueDate": {
            "columns": [
                "dueDate",
                "deleted"
            ]
        },
        "status": {
            "columns": [
                "status",
                "deleted"
            ]
        }
    }
}