		},
		"entityType": {
			"type": "enum",
			"required": true,
			"view": "views/fields/entity-type"
		},
		"generateInAdvance": {
			"type": "enum",
			"options": [
				"1_day",
				"2_days",
				"1_week",
				"2_weeks",
				"1_month",
				"2_months",
				"3_months",
				"6_months",
				"1_year"
			],
			"tooltip": true
		},
		"generateInBatches": {
			"type": "bool"
		},
		"infinite": {
			"type": "bool"
		},
		"lastGenerated": {
			"type": "datetime",
			"readOnly": true
		},
		"name": {
			"type": "varchar",
			"required": true
		},
		"scheduling": {
			"type": "cronExpression",
			"required": true,
			"default": "0 0 * * *",
