{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255,
            "index": true
        },
        "description": {
            "type": "text"
        },
        "type": {
            "type": "enum",
            "options": [
                "Info",
                "Warning", 
                "Success",
                "Danger",
                "Primary"
            ],
            "default": "Info",
            "required": true
        },
        "priority": {
            "type": "enum",
            "options": [
                "Low",
                "Normal",
                "High", 
                "Urgent"
            ],
            "default": "Normal",
            "required": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Active",
                "Resolved",
                "Archived"
            ],
            "default": "Draft",
            "required": true,
            "index": true
        },
        "iconClass": {
            "type": "varchar",
            "maxLength": 100,
            "default": "fas fa-info-circle"
        },
        "color": {
            "type": "varchar",
            "maxLength": 7,
            "default": "#17a2b8"
        },
        "dateStart": {
            "type": "datetime",
            "index": true
        },
        "dateEnd": {
            "type": "datetime", 
            "index": true
        },
        "url": {
            "type": "url",
            "maxLength": 500
        },
        "isClosable": {
            "type": "bool",
            "default": true
        },
        "isGlobal": {
            "type": "bool",
            "default": false,
            "tooltip": "Show to all users"
        },
        "showInDashboard": {
            "type": "bool",
            "default": true
        },
        "showAsPopup": {
            "type": "bool",
            "default": false
        },
        "autoCloseAfter": {
            "type": "int",
            "min": 0,
            "tooltip": "Auto close after X seconds (0 = no auto close)"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true
        },
        "assignedUser": {
            "type": "link"
        },
        "teams": {
            "type": "linkMultiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo", 
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name", "description"]
    },
    "indexes": {
        "status": {
            "columns": ["status"]
        },
        "dateRange": {
            "columns": ["dateStart", "dateEnd"]
        },
        "priority": {
            "columns": ["priority"]
        }
    }
}