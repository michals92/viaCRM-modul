{
    "controller": "controllers/record",
    "recordViews": {
        "detail": "viacrm:views/absence/record/detail",
        "edit": "viacrm:views/absence/record/edit"
    },
    "iconClass": "fas fa-calendar-times",
    "color": "#FF6B6B",
    "quickCreate": true,
    "sidePanelFieldLists": {
        "detail": [],
        "detailSmall": [],
        "edit": []
    },
    "filterList": [
        "pending",
        "approved", 
        "rejected",
        "cancelled"
    ],
    "defaultFilterData": {
        "primary": "pending"
    },
    "dynamicLogic": {
        "fields": {
            "hours": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "startDate"
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "endDate"
                        }
                    ]
                }
            }
        }
    }
}