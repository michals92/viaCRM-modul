{
    "controller": "controllers/record",
    "views": {
        "detail": "viacrm:views/report/record/detail"
    },
    "iconClass": "fas fa-chart-bar",
    "color": "#2ecc71",
    "dynamicLogic": {
        "fields": {
            "chartType": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "type",
                            "value": "Chart"
                        }
                    ]
                }
            },
            "dateFrom": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "dateFilter", 
                            "value": "custom"
                        }
                    ]
                }
            },
            "dateTo": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "dateFilter",
                            "value": "custom"
                        }
                    ]
                }
            }
        }
    }
}