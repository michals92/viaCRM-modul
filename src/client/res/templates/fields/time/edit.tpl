<div class='input-group'>
	<input
		class='main-element form-control'
		type='text'
		data-name='{{name}}'
		value='{{timeValue}}'
		autocomplete='espo-{{name}}'
	/>
	<span class='input-group-btn time-part-btn'>
		<button type='button' class='btn btn-default btn-icon time-picker-btn' tabindex='-1'><i
				class='far fa-clock'
			></i></button>
	</span>
</div>