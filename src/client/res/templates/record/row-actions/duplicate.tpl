{{#unless noWrapper}}
<div class="list-row-buttons btn-group pull-right">
{{/unless}}
    <button
            type="button"
            class="btn btn-link btn-sm action"
            data-action="duplicate"
            data-id="{{modelId}}"
            style="padding:0"
    >
        <i class="fas fa-clone"></i>
    </button>
{{#unless noWrapper}}
</div>
{{/unless}}
