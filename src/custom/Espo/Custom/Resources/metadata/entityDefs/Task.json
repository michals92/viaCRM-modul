{
    "fields": {
        "timeSpent": {
            "type": "float",
            "min": 0,
            "default": 0,
            "readOnly": true,
            "notStorable": true,
            "select": {
                "select": "SUM:(timeEntry.timeSpent)",
                "leftJoins": [
                    [
                        "timeEntries",
                        "timeEntry"
                    ]
                ]
            }
        }
    },
    "links": {
        "timeEntries": {
            "type": "hasMany",
            "entity": "TimeEntry",
            "foreign": "task"
        }
    }
}