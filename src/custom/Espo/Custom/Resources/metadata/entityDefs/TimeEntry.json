{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 255
        },
        "task": {
            "type": "link",
            "required": true
        },
        "user": {
            "type": "link",
            "required": false
        },
        "timeSpent": {
            "type": "float",
            "required": true,
            "min": 0.1,
            "default": 1
        },
        "description": {
            "type": "text"
        },
        "dateLogged": {
            "type": "date",
            "required": false,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true
        }
    },
    "links": {
        "task": {
            "type": "belongsTo",
            "entity": "Task",
            "foreign": "timeEntries"
        },
        "user": {
            "type": "belongsTo",
            "entity": "User"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    }
}