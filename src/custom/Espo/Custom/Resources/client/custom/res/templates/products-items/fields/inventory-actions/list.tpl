<div class="list-field-container">
    <div class="btn-group" role="group">
        <button type="button" class="btn btn-success btn-sm" data-action="createReceipt" title="Vytvořit příjemku" data-id="{{id}}" data-name="{{name}}">
            <i class="fas fa-plus-circle"></i> Příjemka
        </button>
        <button type="button" class="btn btn-warning btn-sm" data-action="CreateIssu" title="Vytvořit výdejku" data-id="{{id}}" data-name="{{name}}">
            <i class="fas fa-minus-circle"></i> Výdejka
        </button>
    </div>
</div>

