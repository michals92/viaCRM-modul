{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"include": [
		"src/client/src/**/*.ts",
		"reset.d.ts"
	],
	"compilerOptions": {
	    "esModuleInterop": true,
    	"skipLibCheck": true,
    	"target": "ESNext",
    	"verbatimModuleSyntax": true,
    	"allowJs": true,
    	"resolveJsonModule": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,

		"moduleResolution": "Bundler",
		"module": "ESNext",
		"noEmit": true,

		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],

		"types": ["@viacrm/types-espocrm"],

		"paths": {
			"espocrm/src/*": ["./node_modules/@viacrm/types-espocrm/src/*"],
			"viacrm/*": ["./node_modules/@viacrm/types-espocrm/modules/viacrm/*"]
		},

		"noPropertyAccessFromIndexSignature": false,
		"noImplicitAny": false
	}
}
