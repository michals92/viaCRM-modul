# EspoCRM Docker Environment Configuration
# Copy this file to .env and customize the values

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=espocrm
MYSQL_USER=espocrm
MYSQL_PASSWORD=your_secure_mysql_password_here

# EspoCRM Configuration
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=your_secure_admin_password_here
ESPOCRM_SITE_URL=http://localhost:8090

# Container Ports (change if needed)
ESPOCRM_PORT=8090
PHPMYADMIN_PORT=8082
MYSQL_PORT=33061

# Optional: Custom configurations
# ESPOCRM_DATABASE_CHARSET=utf8mb4
# ESPOCRM_DATABASE_COLLATE=utf8mb4_unicode_ci
# ESPOCRM_LANGUAGE=en_US
# ESPOCRM_TIMEZONE=UTC

# Security Settings (recommended for production)
# Change these for production deployment
# MYSQL_ROOT_HOST=%
# ESPOCRM_HTTPS=true
# ESPOCRM_SSL_CERTIFICATE_PATH=/path/to/cert
# ESPOCRM_SSL_PRIVATE_KEY_PATH=/path/to/key